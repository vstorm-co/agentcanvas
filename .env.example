# --- Logfire ---
# Read token: required by agentcanvas to query traces via the Logfire Query API.
LOGFIRE_READ_TOKEN=
# Optional: override the Logfire region/base URL (default: https://logfire-us.pydantic.dev).
# For the EU region use https://logfire-eu.pydantic.dev
# LOGFIRE_BASE_URL=
# Write token: used by the demo agent (main.py) to send telemetry to Logfire.
LOGFIRE_WRITE_TOKEN=

# --- Model provider (demo agent only) ---
# The demo uses OpenRouter; set your key here.
OPENROUTER_API_KEY=
